# -*- mode: python ; coding: utf-8 -*-

import os

from PyInstaller.utils.hooks import collect_data_files, collect_submodules

# The .pal tables live outside backend/ because the folder is meant to be
# edited: <repo>/palettes is the source of truth in a checkout. Bundling it
# is not optional -- nexrad_core reads PAL_TABLES["FILE_DR"] and friends at
# import time, so a build without these files is a backend that dies on
# startup rather than one that falls back to the built-in tables.
PAL_SRC = os.path.join(SPECPATH, os.pardir, "palettes")

block_cipher = None

sharppy_imports = collect_submodules('sharppy')
sutils_imports = collect_submodules('sutils')
qtpy_imports = collect_submodules('qtpy')
# xarray resolves its readers lazily by entry point, so PyInstaller's static
# analysis never sees h5netcdf/h5py. Without these the GLM lightning endpoint
# raises "unrecognized engine" only in the packaged build, never in dev.
xarray_imports = collect_submodules('xarray')
h5netcdf_imports = collect_submodules('h5netcdf')
h5py_imports = collect_submodules('h5py')

a = Analysis(
    ['main.py'],
    pathex=[],
    binaries=[],
    datas=(
        collect_data_files('sharppy')
        + collect_data_files('sutils')
        + [(os.path.join(PAL_SRC, '*.pal'), 'palettes')]
    ),
    hiddenimports=[
        *sharppy_imports,
        *sutils_imports,
        *qtpy_imports,
        *xarray_imports,
        *h5netcdf_imports,
        *h5py_imports,
        'uvicorn',
